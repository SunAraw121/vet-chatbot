{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://vet-chatbot-backend.onrender.com/api/$1"
        },
        {
            "source": "/admin",
            "destination": "/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/$1"
        }
    ]
}